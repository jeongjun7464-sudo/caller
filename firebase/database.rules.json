{"rules":{"rooms":{"$room":{".read":"auth != null && data.child('members').child(auth.uid).exists() && data.child('expiresAt').val() > now",".write":"auth != null && ((!data.exists() && newData.child('ownerId').val() == auth.uid) || data.child('members').child(auth.uid).exists())","members":{"$uid":{".validate":"$uid == auth.uid || data.parent().parent().child('ownerId').val() == auth.uid"}},"commands":{"$messageId":{".validate":"newData.hasChildren(['messageId','createdAt']) && newData.child('messageId').val() == $messageId && newData.child('createdAt').val() <= now + 30000"}}}}}}

